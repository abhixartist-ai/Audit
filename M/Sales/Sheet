Sub Prepare_Sales_Vouching()
    Dim wsT As Worksheet, wsV As Worksheet, lr As Long, r As Long, pr As Long
    Dim hd, txt, c
    
    Set wsT = Sheets("Tally")
    On Error Resume Next
    Set wsV = Sheets("Sales Vouching")
    If wsV Is Nothing Then
        Set wsV = Sheets.Add(After:=Sheets(Sheets.Count))
        wsV.Name = "Sales Vouching"
    End If
    On Error GoTo 0
    wsV.Cells.Clear
    
    ' Headings
    hd = Array("Invoice","Customer name","Frame","Invoice Date","Proposal Sheet Date", _
               "Insurance as per tally","Insurance as per Proposal Sheet","Insurance Difff.", _
               "RTO amount as per Proposal Sheet","RTO amount as per tally","RTO Diff.", _
               "Dis Amount Repayment","Disb. Amount as per Tally","Disb. Amount as per Proposal Sheet", _
               "Disb amount diff","TOTAL AS PER TALLY","Actual total as per Proposal Sheet","Total Difference", _
               "Ledger Closing Balance","Sales consultant sign.","Customer sign.","Manager sign.","G M sign.", _
               "Finance Manager sign.","Authorize Discount","Unauthorize Discount","Scheme Discount", _
               "Authorize Person","Observation 1","Observation 2","Observation 3","Auditor","Vouching Date","Management Reply")
    
    For r = 0 To UBound(hd): wsV.Cells(1, r + 1).Value = hd(r): Next
    With wsV.Rows(1)
        .Font.Bold = True
        .RowHeight = 50
        .HorizontalAlignment = xlCenter
        .VerticalAlignment = xlCenter
        .WrapText = True
        .Interior.ColorIndex = xlNone   ' keep blank (no fill) if not colored
    End With
    
    ' Heading colors (only specified ones)
    For Each c In Array("E","F","G","I","J","M","N","P","Q","S","T","U","V","W","X","AC","AD","AE","AF","AG"): wsV.Range(c & "1").Interior.Color = RGB(0, 176, 80): Next
    For Each c In Array("L","AH"): wsV.Range(c & "1").Interior.Color = RGB(0, 176, 240): Next
    For Each c In Array("H"): wsV.Range(c & "1").Interior.Color = RGB(255, 255, 0): Next
    For Each c In Array("K","O","R"): wsV.Range(c & "1").Interior.Color = RGB(255, 0, 0): Next
    For Each c In Array("Y","Z","AA","AB"): wsV.Range(c & "1").Interior.Color = RGB(147, 137, 83): Next
    
    ' Data copy
    lr = wsT.Cells(wsT.Rows.Count, "A").End(xlUp).Row
    pr = 2
    For r = 9 To lr - 1
        wsT.Cells(r, "D").Copy wsV.Cells(pr, "A")   'Tally D → A
        wsT.Cells(r, "B").Copy wsV.Cells(pr, "B")   'Tally B → B
        
        txt = wsV.Cells(pr, "B").Value
        If Len(txt) > 8 Then txt = Right(txt, 8)
        wsV.Cells(pr, "C").Value = txt
        wsV.Cells(pr, "C").Font.Bold = True         'Bold
        
        wsT.Cells(r, "A").Copy wsV.Cells(pr, "D")   'Tally A → D
        pr = pr + 1
    Next
    
    With wsV.UsedRange
        .Columns.AutoFit
        .Borders.LineStyle = xlContinuous
    End With
End Sub